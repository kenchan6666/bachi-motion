{
  "name": "bachi-motion",
  "version": "0.1.0",
  "private": true,
  "description": "bachi-motion Windows desktop shell. Version 0.1.0.",
  "main": "main.js",
  "author": "bachi-motion",
  "build": {
    "appId": "dev.bachi-motion.app",
    "productName": "bachi-motion",
    "asar": true,
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "electron-page.js",
      "bundle/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg/",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "bachi-motion-${version}-win-x64.${ext}"
    },
    "portable": {
      "artifactName": "bachi-motion-${version}-win-x64.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "ffmpeg-static": "^5.2.0"
  }
}
